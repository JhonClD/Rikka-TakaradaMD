# ══════════════════════════════════════════════════════════
#  Rikka-TakaradaMD  ·  Variables de entorno
#  Imagen Docker: ghcr.io/zastinian/esdock:chrnodejs_20
# ══════════════════════════════════════════════════════════

# ── Chromium (ruta en la imagen esdock) ───────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Servidor web ──────────────────────────────────────────
PORT=3000

# ── Temp dir (Docker usa /tmp estándar) ───────────────────
TMPDIR=/tmp

# ── Crunchyroll notifier ──────────────────────────────────
# Intervalo en minutos para verificar nuevos episodios
CR_MINUTES=5

# ── APICausas (search-animeinfo) ──────────────────────────
# Reemplaza con tu clave si tienes una propia
APICAUSAS_KEY=causa-0e3eacf90ab7be15

# ── Python (speedtest) ───────────────────────────────────
# La imagen esdock incluye Python 3 en este path
PYTHON=python3
