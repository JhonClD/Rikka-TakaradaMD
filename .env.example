# API keys usadas por nidl. Nunca pongas valores reales en este archivo.
UPN_SHARE_API_KEY=
VOE_API_KEY=
BYSE_API_KEY=
ONE_FICHIER_API_KEY=

# Clave de api.lolhuman.xyz, usada solo como respaldo de traducción por
# plugins/translate.js. Sin valor, el plugin omite ese respaldo.
LOLHUMAN_API_KEY=

# Nivel del logger interno de Baileys: silent (por defecto), fatal, error,
# warn, info o debug.
LOG_LEVEL=silent

# Traducción del plugin Info anime. Obtén la clave desde Google AI Studio.
GEMINI_API_KEY=
# Opcional: modelo Gemini para traducciones; por defecto gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: configuración de AnimeV1
ANIMEV1_DOMAIN=animeav1.com
ANIMEV1_DOWNLOAD_TIMEOUT_MS=900000

# Opcional: Basic OAuth vigente de Crunchyroll para modo anónimo; no subir valores reales.
CR_BASIC_ANON=

# Opcional: cliente OAuth usado por .crlogin y refresh; acepta "Basic base64(client:secret)".
CR_BASIC_AUTH=
CR_USER_AGENT=
CR_CREDENTIALS_URL=https://raw.githubusercontent.com/vitalygashkov/crextractor/main/credentials.tv.json

# Grupo único que descarga y comprime; los demás grupos reciben el resultado.
TIO_CENTRAL_CHAT_ID=120363410712581446@g.us
TIO_ERROR_OWNER_JID=51925092348@s.whatsapp.net

# Opcional: carpeta pública de Drive para buscar portadas por nombre.
# Debe estar compartida como "Cualquier persona con el enlace".
# Puede ser el ID o la URL completa de una carpeta. Para varias carpetas, separarlas por comas.
GOOGLE_DRIVE_PUBLIC_FOLDER=

# Notificador de AnimeDBS (plugins/dbs-notify.js).
# A quién avisar cuando el notificador falla; por defecto, el mismo del TIO.
DBS_ERROR_OWNER_JID=51925092348@s.whatsapp.net
# Zona horaria con la que se muestra la fecha de publicación del episodio.
DBS_TIMEZONE=America/Lima
# Conexiones paralelas de Mega al descargar (4-32; por defecto 16).
MEGA_MAX_CONNECTIONS=16

# Si AnimeDBS responde 403 (el sitio filtra por IP/huella TLS), el bot ya prueba
# huella de Chrome con wreq-js e impit. Cuando ni eso basta, configura UNA de:
#   DBS_PROXY_URL  proxy HTTP/SOCKS por el que salir, p. ej.
#                  http://usuario:clave@host:8888 o socks5://host:1080
#   DBS_FLARESOLVERR_URL  instancia FlareSolverr accesible desde el bot;
#                  resuelve el desafío de Cloudflare y renueva la cookie
#   DBS_COOKIE     cookie cf_clearance copiada de un navegador del mismo país
#   DBS_UA         User-Agent de ese navegador (debe acompañar a la cookie)
DBS_PROXY_URL=
DBS_FLARESOLVERR_URL=
DBS_COOKIE=
DBS_UA=
# Opcional: forzar qué clientes intentar y en qué orden (por defecto todos).
# Ej.: DBS_HTTP_ESTRATEGIAS=axios,curl
DBS_HTTP_ESTRATEGIAS=

# Descargador MixDrop (plugins/mixdrop-dl.js).
# Si mxcontent.net bloquea la IP del servidor, usa un proxy HTTP o SOCKS
# con salida HTTPS/CONNECT. Formatos: http://usuario:clave@host:puerto o socks5://host:puerto
MIXDROP_PROXY_URL=

# Candidatos públicos de monosans/proxy-list, comprobados el 2026-11-22.
# Solo se verificó conectividad con HEAD: la CDN respondió HTTP 403 sin la query firmada.
# No se confirmó la descarga del video. Son proxies anónimos, efímeros y no confiables.
