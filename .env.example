# API keys usadas por nidl. Nunca pongas valores reales en este archivo.
UPN_SHARE_API_KEY=
VOE_API_KEY=
BYSE_API_KEY=
ONE_FICHIER_API_KEY=

# Opcional: configuración de AnimeV1
ANIMEV1_DOMAIN=animeav1.com
ANIMEV1_DOWNLOAD_TIMEOUT_MS=900000

# Opcional: Basic OAuth vigente de Crunchyroll para modo anónimo; no subir valores reales.
CR_BASIC_ANON=

# Opcional: cliente OAuth usado por .crlogin y refresh; acepta "Basic base64(client:secret)".
CR_BASIC_AUTH=
CR_USER_AGENT=
CR_CREDENTIALS_URL=https://raw.githubusercontent.com/vitalygashkov/crextractor/main/credentials.tv.json

# Grupo único que descarga y comprime; los demás grupos reciben el resultado.
TIO_CENTRAL_CHAT_ID=120363410712581446@g.us
TIO_ERROR_OWNER_JID=51925092348@s.whatsapp.net

# Opcional: carpeta pública de Drive para buscar portadas por nombre.
# Debe estar compartida como "Cualquier persona con el enlace".
# Puede ser el ID o la URL completa de una carpeta. Para varias carpetas, separarlas por comas.
GOOGLE_DRIVE_PUBLIC_FOLDER=
